# Install:
#   sudo install -m755 target/release/net-watch /usr/local/bin/
#   sudo cp deploy/net-watch.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now net-watch
[Unit]
Description=net-watch per-process network accounting (eBPF)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Loading fentry/fexit programs needs root (CAP_BPF + CAP_PERFMON at minimum).
User=root
EnvironmentFile=-/etc/default/net-watch
ExecStart=/usr/local/bin/net-watch
Restart=always
RestartSec=2
# Belt and braces with --cpus: keep the collector off the monitored workloads' cores.
CPUAffinity=62 63
LimitMEMLOCK=infinity
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
