{
  "name": "net-watch-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web dashboard for net-watch data in Redis and ClickHouse",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "node --test src/server/**/*.test.ts src/client/**/*.test.ts",
    "test:int": "node --test src/server/**/*.int.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@fastify/static": "^10.1.4",
    "echarts": "^6.1.0",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
