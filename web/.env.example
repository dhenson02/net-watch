# Copy to .env and adjust. Real environment variables override this file.

# Where the dashboard listens. Keep it on loopback and use an SSH tunnel
# (ssh -L 8787:127.0.0.1:8787 host) unless you put auth in front of it.
WEB_HOST=127.0.0.1
WEB_PORT=8787

REDIS_URL=redis://127.0.0.1:6379

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=netwatch
CLICKHOUSE_PASSWORD=netwatch
CLICKHOUSE_DATABASE=netwatch

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Ticks (1 s each) the dashboard keeps for live charts. Loading more slows startup.
LIVE_BACKFILL=900

# IP → ASN / country table for the Destinations page: iptoasn.com's
# ip2asn-combined.tsv(.gz), fetched only by `npm run geo:update`. Relative to
# web/. Without the file the dashboard works, just without ASN/country.
GEOIP_FILE=data/ip2asn-combined.tsv.gz

# 1 enables reverse DNS on demand in the destination table. Off by default:
# each lookup sends a DNS query from this host.
RDNS=0

# Password asked for by the Storage page before it deletes stored data (ClickHouse
# partitions, ended Redis processes). Unset or empty: deleting is disabled.
STORAGE_ADMIN_PASSWORD=
